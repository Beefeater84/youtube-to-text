{
  "manifest_version": 3,
  "name": "YT2Text",
  "version": "0.1.0",
  "description": "Save YouTube transcripts to yt-reader.com",
  "permissions": ["storage", "identity", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.yt-reader.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["src/content/youtube.tsx"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "YT2Text"
  }
}

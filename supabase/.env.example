# Local Supabase CLI stack: this project's own auth keys.
# Generate the real file with: bash scripts/supabase-env.sh
# Read by supabase/config.toml via env(...). Never commit supabase/.env.

# HS256 secret that signs auth JWTs (min 32 chars). anon and service_role
# keys are derived from it by the CLI. The short name is deliberate, see the
# comment at jwt_secret in supabase/config.toml.
JWT_SECRET=

# API keys in the CLI format: sb_publishable_... and sb_secret_...
SUPABASE_AUTH_PUBLISHABLE_KEY=
SUPABASE_AUTH_SECRET_KEY=
